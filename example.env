OPENAI_API_KEY = 
GROQ_API_KEY = 

# Local Redis password. Defaults to localdev in docker-compose if unset.
REDIS_PASSWORD=localdev

# Telemetry. Unset or empty, the application behaves exactly as it did before:
# no exporter, no network calls, plain behaviour in the tests and the eval
# harness. Set it and bring the stack up with:
#
#   docker compose --profile observability up
#
# Grafana is then on http://localhost:3001 (anonymous, local only) with the
# five dashboards already provisioned. See docs/AUDIT.md 18.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# The API's published host port. Used by BOTH the port mapping and the URL
# baked into the frontend bundle, so they cannot disagree. Change it if 8080
# is taken on your machine.
API_PORT=8080

# Where the browser reaches Grafana, for the Analytics tab's embed. Empty
# hides that tab. PROMETHEUS_URL is server-side and defaults to the compose
# service, so it normally needs no setting.
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001

# Leave both empty for local work: empty means "no identity pool", and the UI
# uses the DEV_AUTH token issuer as it always has. Set them to the values in
# `terraform output cognito_user_pool_id` / `cognito_client_id` and the UI asks
# for a real Cognito sign-in instead. They are baked into the bundle at build
# time, so changing them needs a rebuild, not a restart.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
