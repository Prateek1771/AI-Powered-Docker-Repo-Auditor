OPENAI_API_KEY = 
GROQ_API_KEY = 

# Local Redis password. Defaults to localdev in docker-compose if unset.
REDIS_PASSWORD=localdev

# Telemetry. Unset or empty, the application behaves exactly as it did before:
# no exporter, no network calls, plain behaviour in the tests and the eval
# harness. Set it and bring the stack up with:
#
#   docker compose --profile observability up
#
# Grafana is then on http://localhost:3001 (anonymous, local only) with the
# five dashboards already provisioned. See docs/audits/audit-01-backend.md 18.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# The API's published host port. Used by BOTH the port mapping and the URL
# baked into the frontend bundle, so they cannot disagree. Change it if 8080
# is taken on your machine.
API_PORT=8080

# Where the browser reaches Grafana, for the Analytics tab's embed. Empty
# hides that tab. PROMETHEUS_URL is server-side and defaults to the compose
# service, so it normally needs no setting.
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001

# Route every model call through the Bifrost gateway. Empty calls OpenAI
# directly, which is the default and what CI does.
#
# Set it and you get failover across keys and providers, spend budgets, and
# bifrost_cost_total - actual USD per model, which is the cost metric the audit
# asked for and could not maintain by hand. CVE_MODEL is prefixed to
# "openai/..." automatically when this is set.
#
# Not caching, and the plan said otherwise, so: measured. Two back-to-back CLI
# scans of alpine:3.18 through the gateway cost 3703 and 3700 input tokens -
# no saving. Two reasons, both real. Bifrost's semantic cache is a plugin that
# needs a vector store and is off by default; and OpenAI's automatic prompt
# cache needs a 1024-token identical prefix, which a small image's agent
# prompts (~600 tokens each) never reach. A 1816-token prompt sent twice does
# cache - 1664 tokens read - so the path works, it just does not fire here.
#
# The semantic cache is deliberately left off rather than merely unconfigured:
# it answers a near-match prompt with a previous answer, and on a scanner that
# means one image's findings reported against another's.
#
# The gateway's own UI is on http://localhost:8085.
LLM_GATEWAY_URL=http://bifrost:8080/v1

# Optional. A second provider turns an exhausted key from an outage into a
# failover.
ANTHROPIC_API_KEY=

# Leave both empty for local work: empty means "no identity pool", and the UI
# uses the DEV_AUTH token issuer as it always has. Set them to the values in
# `terraform output cognito_user_pool_id` / `cognito_client_id` and the UI asks
# for a real Cognito sign-in instead. They are baked into the bundle at build
# time, so changing them needs a rebuild, not a restart.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
